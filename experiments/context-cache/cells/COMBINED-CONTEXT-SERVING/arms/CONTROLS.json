{
  "canonical": {
    "encoding": "utf-8",
    "json": {"sort_keys": true, "separators": [",", ":"], "ensure_ascii": false},
    "trailing_whitespace": "none",
    "line_endings": "LF"
  },
  "store": {
    "root": "arms/store",
    "digest": "full 64-hex sha256",
    "truncated_allowed": false
  },
  "mask_K_default": 12,
  "arms": ["A", "B", "C"]
}
