@article{benayas2024comparative,
  author    = {Benayas, Alberto and Sicilia, Miguel {\'A}ngel and Mora-Cantallops, Mar{\c c}al},
  title     = {A Comparative Analysis of Encoder Only and Decoder Only Models in Intent Classification and
               Sentiment Analysis: Navigating the Trade-Offs in Model Size and Performance},
  journal   = {Language Resources and Evaluation},
  volume    = {59},
  number    = {3},
  pages     = {2007--2030},
  year      = {2024},
  publisher = {Springer},
  doi       = {10.1007/s10579-024-09796-y},
  url       = {https://doi.org/10.1007/s10579-024-09796-y},
  note      = {FOUND (REFS.md A3 / OPEN\_QUESTIONS.md Q5.2 — the corpus's ``125M RoBERTa beats a fine-tuned
               LLaMA2-7B'' claim). Located and read by delegated subagent \texttt{c1b0bcc5} on 2026-10-15 via
               the Crossref API; the identifiers above are Crossref metadata for the peer-reviewed version,
               and Unpaywall confirms the journal article is open access via the preprint. \textbf{Preprint:}
               Research Square, posted 2024-01-17, DOI \texttt{10.21203/rs.3.rs-3865391/v1},
               \url{https://www.researchsquare.com/article/rs-3865391/v1.pdf} (both facts from the fetched
               PDF and \texttt{api.crossref.org}). \textbf{No arXiv version exists.} Verbatim, Table 2
               (``F1-Score macro and micro averaged, for the Intent Classification task''; Banking = BANKING77,
               77 intents), Banking column macro/micro: RoBERTa \texttt{94.27 / 94.28}; LLaMA2-Fine-Tuned
               \texttt{70.87 / 72.17}; LLaMA2-Zero-Shots \texttt{30.85 / 27.24}; LLaMA2-Few-Shots
               \texttt{47.40 / 45.00}. Verbatim \S4.1: ``The performance gap between RoBERTa and all LLaMA2
               approaches grows with the number of classes in the dataset~\dots a dataset like Banking with
               77 classes shows the biggest performance gap.'' Verbatim, Table 7 (``Latency multiples taking
               RoBERTa inference time as a baseline. Calculated on a single T4 GPU machine.''): Fine-Tuned
               LLaMA2 at 10/25/50 max output tokens = \texttt{29x / 56x / 108x}. \textbf{Four details the
               corpus embellished — do not repeat them as the paper's:} (1) the paper never prints ``125M'';
               it says RoBERTa-base is ``approximately 110-120 million parameters''; (2) ``+23.4 F1'' is the
               corpus's arithmetic (94.27 $-$ 70.87), not printed; (3) the 94.27/70.87 pair are the MACRO
               figures (micro are 94.28/72.17); (4) the speedup is a serving measurement on one T4 at fixed
               output-token budgets, and the body text frames the gap more loosely as ``one to two orders of
               magnitude''. \textbf{Why it matters to this paper:} the same table supplies a peer-reviewed,
               same-task prompted-versus-fine-tuned contrast (prompted LLaMA2 loses badly on Banking), i.e.
               independent support for the artefact this paper diagnoses — the paper should use it that way,
               not only as a corroborating encoder win.}
}

